{
  "manifest_version": 1,
  "type": "device",
  "name": "Opower (US utilities)",
  "description": {
    "en": "Electricity and gas usage, cost and bill forecast from US utilities on Opower (PG&E, ConEd...).",
    "fr": "Consommation, coût et prévision de facture des fournisseurs américains sur Opower (PG&E, ConEd…).",
    "de": "Strom- und Gasverbrauch, Kosten und Rechnungsprognose von US-Versorgern auf Opower (PG&E…).",
    "es": "Consumo, coste y previsión de factura de las compañías de EE. UU. en Opower (PG&E, ConEd…)."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-opower:1.0.0",
  "gladys_version": ">=5.2.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-opower/main/cover.png",
  "categories": ["energy"],
  "transports": ["cloud"],
  "config_schema": [
