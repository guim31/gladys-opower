    {
      "key": "username",
      "type": "string",
      "label": {
        "en": "Username or email",
        "fr": "Identifiant ou e-mail",
        "de": "Benutzername oder E-Mail",
        "es": "Usuario o correo electrónico"
      },
      "placeholder": {
        "en": "e.g. name@example.com",
        "fr": "ex. nom@example.com",
        "de": "z. B. name@example.com",
        "es": "p. ej. nombre@example.com"
      },
      "required": true
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Password",
        "fr": "Mot de passe",
        "de": "Passwort",
        "es": "Contraseña"
      },
      "required": true
    },
    {
      "key": "totp_secret",
      "type": "secret",
      "label": {
        "en": "Authenticator secret key (ConEd, O&R)",
        "fr": "Clé secrète d’authentification (ConEd, O&R)",
        "de": "Geheimer Authenticator-Schlüssel (ConEd, O&R)",
        "es": "Clave secreta de autenticación (ConEd, O&R)"
      },
      "description": {
        "en": "Only for ConEd and O&R accounts with two-step sign-in by authenticator app: the key shown when you set the app up.",
        "fr": "Seulement pour les comptes ConEd et O&R à double authentification par application : la clé affichée lors de son installation.",
        "de": "Nur für ConEd- und O&R-Konten mit Zwei-Faktor-Anmeldung per Authenticator-App: der beim Einrichten angezeigte Schlüssel.",
        "es": "Solo para cuentas de ConEd y O&R con verificación en dos pasos por aplicación: la clave mostrada al configurarla."
      },
      "required": false
    },
    {
      "key": "history_days",
      "type": "select",
      "label": {
        "en": "History to import",
        "fr": "Historique à importer",
        "de": "Zu importierender Verlauf",
        "es": "Historial que importar"
      },
      "description": {
        "en": "Electricity days sent to the Gladys energy tracking on the first reading.",
        "fr": "Jours d’électricité envoyés au suivi d’énergie de Gladys à la première lecture.",
        "de": "Stromtage, die beim ersten Lesen an die Energieüberwachung von Gladys gehen.",
        "es": "Días de electricidad enviados al seguimiento de energía de Gladys en la primera lectura."
      },
      "required": false,
      "default": "30",
      "options": [
        {
          "value": "7",
          "label": {
            "en": "7 days",
            "fr": "7 jours",
            "de": "7 Tage",
            "es": "7 días"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 days",
            "fr": "30 jours",
            "de": "30 Tage",
            "es": "30 días"
          }
        },
        {
          "value": "90",
          "label": {
            "en": "90 days",
            "fr": "90 jours",
            "de": "90 Tage",
            "es": "90 días"
          }
        },
        {
          "value": "365",
          "label": {
            "en": "1 year",
            "fr": "1 an",
            "de": "1 Jahr",
            "es": "1 año"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of device names",
        "fr": "Langue des noms d’appareils",
        "de": "Sprache der Gerätenamen",
        "es": "Idioma de los nombres de dispositivos"
      },
      "description": {
        "en": "Names are set when you add a meter to Gladys.",
        "fr": "Les noms sont fixés à l’ajout d’un compteur dans Gladys.",
        "de": "Die Namen werden beim Hinzufügen eines Zählers zu Gladys festgelegt.",
        "es": "Los nombres se fijan al añadir un contador a Gladys."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    },
    {
      "key": "code_help",
      "type": "section",
      "label": {
        "en": "Verification code (PG&E, Exelon)",
        "fr": "Code de vérification (PG&E, Exelon)",
        "de": "Bestätigungscode (PG&E, Exelon)",
        "es": "Código de verificación (PG&E, Exelon)"
      },
      "description": {
        "en": "PG&E and the Exelon companies (ComEd, PECO, BGE, Pepco, Delmarva, ACE) may ask for a code sent by email or text: use the two actions below, “Send the verification code” then “Enter the code”. The sign-in is then remembered.",
        "fr": "PG&E et les sociétés Exelon (ComEd, PECO, BGE, Pepco, Delmarva, ACE) peuvent demander un code envoyé par e-mail ou SMS : utilisez les deux actions ci-dessous, « Envoyer le code de vérification » puis « Saisir le code ». La connexion est ensuite mémorisée.",
        "de": "PG&E und die Exelon-Gesellschaften (ComEd, PECO, BGE, Pepco, Delmarva, ACE) können einen per E-Mail oder SMS gesendeten Code verlangen: nutze die zwei Aktionen unten, „Bestätigungscode senden“ und dann „Code eingeben“. Die Anmeldung wird danach gespeichert.",
        "es": "PG&E y las empresas de Exelon (ComEd, PECO, BGE, Pepco, Delmarva, ACE) pueden pedir un código enviado por correo o SMS: use las dos acciones de abajo, «Enviar el código de verificación» y luego «Introducir el código». El inicio de sesión queda guardado."
      }
    }
  ],
  "actions": [
    {
      "key": "send_code",
      "label": {
        "en": "Send the verification code",
        "fr": "Envoyer le code de vérification",
        "de": "Bestätigungscode senden",
        "es": "Enviar el código de verificación"
      },
      "description": {
        "en": "Asks your utility to send the sign-in code (PG&E, Exelon companies).",
        "fr": "Demande à votre fournisseur d’envoyer le code de connexion (PG&E, sociétés Exelon).",
        "de": "Bittet deinen Versorger, den Anmeldecode zu senden (PG&E, Exelon-Gesellschaften).",
        "es": "Pide a su compañía que envíe el código de inicio de sesión (PG&E, empresas de Exelon)."
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "method",
          "type": "select",
          "label": {
            "en": "Send by",
            "fr": "Envoyer par",
            "de": "Senden per",
            "es": "Enviar por"
          },
          "required": true,
          "options": [
            {
              "value": "email",
              "label": {
                "en": "Email",
                "fr": "E-mail",
                "de": "E-Mail",
                "es": "Correo electrónico"
              }
            },
            {
              "value": "sms",
              "label": {
                "en": "Text message",
                "fr": "SMS",
                "de": "SMS",
                "es": "SMS"
              }
            }
          ]
        }
      ]
    },
    {
      "key": "submit_code",
      "label": {
        "en": "Enter the code",
        "fr": "Saisir le code",
        "de": "Code eingeben",
        "es": "Introducir el código"
      },
      "description": {
        "en": "Checks the code you received; the sign-in is then remembered.",
        "fr": "Vérifie le code reçu ; la connexion est ensuite mémorisée.",
        "de": "Prüft den erhaltenen Code; die Anmeldung wird danach gespeichert.",
        "es": "Comprueba el código recibido; el inicio de sesión queda guardado."
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "code",
          "type": "string",
          "label": {
            "en": "Verification code",
            "fr": "Code de vérification",
            "de": "Bestätigungscode",
            "es": "Código de verificación"
          },
          "placeholder": {
            "en": "e.g. 123456",
            "fr": "ex. 123456",
            "de": "z. B. 123456",
            "es": "p. ej. 123456"
          },
          "required": true
        }
      ]
    },
    {
      "key": "refresh_now",
      "label": {
        "en": "Sign in and refresh now",
        "fr": "Se connecter et rafraîchir",
        "de": "Anmelden und jetzt aktualisieren",
        "es": "Iniciar sesión y actualizar"
      },
      "description": {
        "en": "Signs in and reads the meters now, instead of waiting for the 12-hour cycle.",
        "fr": "Se connecte et lit les compteurs maintenant, sans attendre le cycle de 12 heures.",
        "de": "Meldet sich an und liest die Zähler jetzt, statt auf den 12-Stunden-Zyklus zu warten.",
        "es": "Inicia sesión y lee los contadores ahora, sin esperar al ciclo de 12 horas."
      },
      "timeout_seconds": 120
    }
  ],
  "scene_triggers": [
    {
      "key": "daily_usage_available",
      "label": {
        "en": "New day of usage available",
        "fr": "Nouvelle journée de consommation",
        "de": "Neuer Verbrauchstag verfügbar",
        "es": "Nuevo día de consumo disponible"
      },
      "description": {
        "en": "The utility published a new complete day for a meter (often a day or two late).",
        "fr": "Le fournisseur a publié une nouvelle journée complète pour un compteur (souvent avec un ou deux jours de retard).",
        "de": "Der Versorger hat einen neuen vollständigen Tag für einen Zähler veröffentlicht (oft ein bis zwei Tage später).",
        "es": "La compañía publicó un nuevo día completo para un contador (a menudo con uno o dos días de retraso)."
      },
      "fields": [
        {
          "key": "meter",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Meter",
            "fr": "Compteur",
            "de": "Zähler",
            "es": "Contador"
          }
        }
      ],
      "variables": [
        {
          "key": "date",
          "type": "string",
          "label": {
            "en": "Day (YYYY-MM-DD)",
            "fr": "Jour (AAAA-MM-JJ)",
            "de": "Tag (JJJJ-MM-TT)",
            "es": "Día (AAAA-MM-DD)"
          }
        },
        {
          "key": "usage",
          "type": "number",
          "label": {
            "en": "Usage of the day",
            "fr": "Consommation du jour",
            "de": "Verbrauch des Tages",
            "es": "Consumo del día"
          }
        },
        {
          "key": "unit",
          "type": "string",
          "label": {
            "en": "Unit",
            "fr": "Unité",
            "de": "Einheit",
            "es": "Unidad"
          }
        },
        {
          "key": "cost",
          "type": "number",
          "label": {
            "en": "Cost of the day ($)",
            "fr": "Coût du jour ($)",
            "de": "Kosten des Tages ($)",
            "es": "Coste del día ($)"
          }
        },
        {
          "key": "month_usage",
          "type": "number",
          "label": {
            "en": "Usage of the month",
            "fr": "Consommation du mois",
            "de": "Verbrauch des Monats",
            "es": "Consumo del mes"
          }
        },
        {
          "key": "month_cost",
          "type": "number",
          "label": {
            "en": "Cost of the month ($)",
            "fr": "Coût du mois ($)",
            "de": "Kosten des Monats ($)",
            "es": "Coste del mes ($)"
          }
        },
        {
          "key": "forecast_cost",
          "type": "number",
          "label": {
            "en": "Bill forecast ($)",
            "fr": "Prévision de facture ($)",
            "de": "Rechnungsprognose ($)",
            "es": "Previsión de factura ($)"
          }
        }
      ]
    },
    {
      "key": "sign_in_required",
      "label": {
        "en": "Utility sign-in needs you",
        "fr": "Connexion au fournisseur à refaire",
        "de": "Anmeldung beim Versorger nötig",
        "es": "Hay que volver a iniciar sesión"
      },
      "description": {
        "en": "The utility asks for a verification code, or refused the password: the readings stop until you act.",
        "fr": "Le fournisseur demande un code de vérification ou refuse le mot de passe : les relevés s’arrêtent jusqu’à votre intervention.",
        "de": "Der Versorger verlangt einen Bestätigungscode oder lehnt das Passwort ab: die Ablesungen stoppen, bis du handelst.",
        "es": "La compañía pide un código de verificación o rechaza la contraseña: las lecturas se detienen hasta que usted actúe."
      },
      "fields": [
        {
          "key": "reason",
          "type": "multi_select",
          "label": {
            "en": "Reason",
            "fr": "Raison",
            "de": "Grund",
            "es": "Motivo"
          },
          "options": [
            {
              "value": "code",
              "label": {
                "en": "Verification code",
                "fr": "Code de vérification",
                "de": "Bestätigungscode",
                "es": "Código de verificación"
              }
            },
            {
              "value": "password",
              "label": {
                "en": "Password refused",
                "fr": "Mot de passe refusé",
                "de": "Passwort abgelehnt",
                "es": "Contraseña rechazada"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "utility",
          "type": "string",
          "label": {
            "en": "Utility",
            "fr": "Fournisseur",
            "de": "Versorger",
            "es": "Compañía"
          }
        },
        {
          "key": "reason",
          "type": "string",
          "label": {
            "en": "Reason",
            "fr": "Raison",
            "de": "Grund",
            "es": "Motivo"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "get_meter_summary",
      "label": {
        "en": "Read a meter summary",
        "fr": "Lire le bilan d’un compteur",
        "de": "Zählerübersicht lesen",
        "es": "Leer el resumen de un contador"
      },
      "description": {
        "en": "Gives the last complete day, the month and the bill forecast of a meter, for a message.",
        "fr": "Donne le dernier jour complet, le mois et la prévision de facture d’un compteur, pour un message.",
        "de": "Liefert den letzten vollständigen Tag, den Monat und die Rechnungsprognose eines Zählers, für eine Nachricht.",
        "es": "Da el último día completo, el mes y la previsión de factura de un contador, para un mensaje."
      },
      "timeout_seconds": 10,
      "fields": [
        {
          "key": "meter",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Meter",
            "fr": "Compteur",
            "de": "Zähler",
            "es": "Contador"
          },
          "required": true
        }
      ],
      "outputs": [
        {
          "key": "date",
          "type": "string",
          "label": {
            "en": "Last complete day",
            "fr": "Dernier jour complet",
            "de": "Letzter vollständiger Tag",
            "es": "Último día completo"
          }
        },
        {
          "key": "usage",
          "type": "number",
